ADMIN_PASSWORD=promoplanet2026
SESSION_SECRET=reemplazar-por-string-aleatorio-largo-y-seguro
# Opción A (producción/Render): JSON completo de la Service Account como string
# GOOGLE_SA_CREDENTIALS={"type":"service_account","project_id":"..."}
# Opción B (local): ruta al archivo JSON
GOOGLE_SA_KEY_FILE=./service-account.json
PORT=3000

# Base de datos — Turso (requerido en producción; en dev usa SQLite local automáticamente)
TURSO_URL=libsql://tu-db.turso.io
TURSO_TOKEN=tu-token-de-turso

# Cloudinary (subida de fotos de productos)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
